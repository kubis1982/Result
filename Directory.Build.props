<Project>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>kubis1982.FluentResult</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<Copyright>Copyright © 2026 Mariusz Świątnicki.</Copyright>
		<Authors>Mariusz Świątnicki</Authors>
		<PackageProjectUrl>https://github.com/kubis1982/fluent-result</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kubis1982/fluent-result</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

</Project>
